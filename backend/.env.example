PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
JWT_SECRET=change_me_with_long_random_secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=https://bokun-zanzibar-booking.vercel.app
# You can provide multiple origins separated by commas (for example custom domain + vercel domain)
# FRONTEND_URL=https://bokun-zanzibar-booking.vercel.app,https://www.yourdomain.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1200
DEFAULT_CURRENCY=USD
ACCOUNTING_BASE_CURRENCY=USD
EXPENSE_POSTING_MODE=PREVIEW_ONLY
EXPENSE_AUTOMATIC_POSTING_ENABLED=false
SUPPLIER_PAYMENT_AUTOMATIC_POSTING_ENABLED=false
# Keep AR automation independent and disabled until accounting policy is approved.
AR_AUTOMATIC_RECOGNITION_ENABLED=false
# Service revenue uses its own guarded event path. These values do not activate it.
REVENUE_RECOGNITION_AUTOMATIC_ENABLED=false
# Explicit owner-approved UTC timestamp; never generated on startup.
REVENUE_RECOGNITION_ACTIVATED_AT=
# NEW_BOOKINGS_AND_COMPLETIONS or NEW_COMPLETIONS; no implicit default.
REVENUE_RECOGNITION_ACTIVATION_SCOPE=
CUSTOMER_PAYMENT_AUTOMATIC_POSTING_ENABLED=false

# Bokun API
BOKUN_BASE_URL=https://api.bokun.io
BOKUN_ACCESS_KEY=
BOKUN_SECRET_KEY=
BOKUN_API_KEY=
BOKUN_TIMEOUT_MS=30000
BOKUN_RETRY_COUNT=2
BOKUN_MOCK_MODE=false
BOKUN_WEBHOOK_SECRET=
BOKUN_BOOKING_SYNC_ENABLED=false
BOKUN_BOOKING_SYNC_INTERVAL_SECONDS=300
BOKUN_BOOKING_SYNC_BATCH_SIZE=20
BOKUN_CONFIRMED_BOOKING_IMPORT_ENABLED=true
BOKUN_CONFIRMED_BOOKING_IMPORT_INTERVAL_SECONDS=900
BOKUN_CONFIRMED_BOOKING_IMPORT_BATCH_SIZE=50
BOKUN_CONFIRMED_BOOKING_IMPORT_MAX_PAGES=5
BOKUN_CONFIRMED_BOOKING_IMPORT_LOOKBACK_DAYS=30
BOKUN_CONFIRMED_BOOKING_IMPORT_STATUSES=CONFIRMED,CANCELLED
BOOKING_FINALIZATION_RETRY_ENABLED=true
BOOKING_FINALIZATION_RETRY_INTERVAL_SECONDS=30
BOOKING_FINALIZATION_RETRY_BATCH_SIZE=20
BOOKING_FINALIZATION_MAX_RETRIES=8
# Backfill invoices for existing bookings that were imported without one.
INVOICE_SYNC_ENABLED=true
INVOICE_SYNC_INTERVAL_SECONDS=300
INVOICE_SYNC_BATCH_SIZE=100
REFUND_RECONCILIATION_ENABLED=true
REFUND_RECONCILIATION_INTERVAL_MINUTES=10
# Optional backward-compatible override. Leave 0 to use REFUND_RECONCILIATION_INTERVAL_MINUTES.
REFUND_RECONCILIATION_INTERVAL_SECONDS=0
REFUND_RECONCILIATION_BATCH_SIZE=20
REFUND_RECONCILIATION_MIN_AGE_SECONDS=300
REFUND_RECONCILIATION_MAX_RETRIES=8
BOOKING_LEGACY_PRICING_RECOVERY_ENABLED=true
BOOKING_LEGACY_PRICING_RECOVERY_BATCH_SIZE=10

# Pesapal (V3 API)
PESAPAL_BASE_URL=https://pay.pesapal.com/v3/api
PESAPAL_AUTH_PATH=/Auth/RequestToken
PESAPAL_SUBMIT_ORDER_PATH=/Transactions/SubmitOrderRequest
PESAPAL_STATUS_PATH=/Transactions/GetTransactionStatus
PESAPAL_REFUND_PATH=/Transactions/RefundRequest
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
# Use PUBLIC URLs in live mode. Success/cancel URLs must use one of the FRONTEND_URL origins.
# For local live tests, expose frontend and backend with the same tunnel environment.
PESAPAL_SUCCESS_URL=https://your-public-domain.com/payment-success
# Pesapal cancellations are verified on the branded result page; keep this on the same frontend origin.
PESAPAL_CANCEL_URL=https://your-public-domain.com/payment-failure
PESAPAL_CALLBACK_URL=
# Public backend callback URL used to register Pesapal IPN automatically in live mode.
PESAPAL_IPN_URL=https://your-public-backend-domain.com/api/payments/pesapal/ipn
PESAPAL_IPN_ID=
PESAPAL_TIMEOUT_MS=20000
PESAPAL_MOCK_MODE=true
PESAPAL_ALLOW_LOCAL_REDIRECTS=false
# Decimal tolerance used only for same-currency provider comparisons.
PAYMENT_SAME_CURRENCY_TOLERANCE=0.005

# DPO / Direct Pay Online
DPO_BASE_URL=https://secure.3gdirectpay.com
DPO_API_PATH=/API/v6/
DPO_PAYMENT_PATH=/payv3.php
DPO_COMPANY_TOKEN=
DPO_SERVICE_TYPE=
DPO_SUCCESS_URL=https://your-public-domain.com/payment-success
DPO_CANCEL_URL=https://your-public-domain.com/payment-failure
DPO_CALLBACK_URL=
DPO_TIMEOUT_MS=20000
DPO_MOCK_MODE=true
DPO_ALLOW_LOCAL_REDIRECTS=false
# Must match currencies enabled by DPO for this exact merchant account.
DPO_APPROVED_CURRENCIES=USD

# PayPal Orders API
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_SUCCESS_URL=https://your-public-domain.com/payment-success
PAYPAL_CANCEL_URL=https://your-public-domain.com/payment-failure
PAYPAL_TIMEOUT_MS=20000
PAYPAL_MOCK_MODE=true
PAYPAL_ALLOW_LOCAL_REDIRECTS=false

# Booking business defaults
GLOBAL_AGENT_COMMISSION_PERCENT=10
QUOTE_TTL_MINUTES=15
TAX_PERCENT=0

# Transactional email via Resend. Set EMAIL_ENABLED=true only after the sender domain is verified in Resend.
EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Riser Tours & Safaris <bookings@yourdomain.com>
EMAIL_REPLY_TO=info@risertoursandsafaris.co.tz

# Google Places reviews (optional). Reviews remain hidden until both values are configured.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_REVIEW_URL=

# Disaster recovery / MongoDB backup controls
DR_BACKUP_DIRECTORY=backups/mongodb
DR_BACKUP_STORAGE_PROVIDER=local_filesystem
DR_BACKUP_RETENTION_DAYS=30
DR_BACKUP_RPO_HOURS=24
DR_BACKUP_RTO_HOURS=4
# Keep false in production except during an explicitly approved restore window.
DR_ALLOW_PRODUCTION_RESTORE=false
