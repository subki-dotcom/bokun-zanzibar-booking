{
  "name": "zanzibar-booking-backend",
  "version": "1.0.0",
  "description": "Production-ready Bokun integration backend for Zanzibar tours",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "migrate:multi-currency": "node scripts/migrateMultiCurrencyPayments.js",
    "migrate:multi-currency:write": "node scripts/migrateMultiCurrencyPayments.js --write",
    "lint": "eslint 'src/**/*.js' --ext .js",
    "format": "prettier --write 'src/**/*.js' 'scripts/**/*.js' server.js",
    "backup:dry-run": "node scripts/backup-database.js --dry-run",
    "backup:apply": "node scripts/backup-database.js --apply",
    "restore:dry-run": "node scripts/restore-database.js --dry-run",
    "test": "node --test",
    "test:smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "axios-retry": "^4.5.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "country-telephone-data": "^0.6.3",
    "dayjs": "^1.11.13",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "envalid": "^8.0.0",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.1",
    "morgan": "^1.10.0",
    "slugify": "^1.6.6",
    "uuid": "^10.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-node": "^11.1.0",
    "prettier": "^3.0.0"
  }
}
