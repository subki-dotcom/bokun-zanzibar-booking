VITE_API_BASE_URL=https://bokun-zanzibar-booking.onrender.com
SEO_API_BASE_URL=https://bokun-zanzibar-booking.onrender.com/api
VITE_SITE_URL=https://zanzibartoursandsafaris.co.tz
# Set this to the GA4 web stream Measurement ID in the deployment environment before building.
VITE_GA_MEASUREMENT_ID=
VITE_ANALYTICS_DEBUG=false
# Google Ads (AW-18541089433). Leave a label empty to skip that Ads conversion.
# Purchase conversion label; direct purchase conversions also need VITE_GOOGLE_ADS_DIRECT_CONVERSIONS=true.
VITE_GOOGLE_ADS_BOOKING_LABEL=
VITE_GOOGLE_ADS_DIRECT_CONVERSIONS=false
# "Contact form submitted" (Submit lead form). This value is also the built-in default.
VITE_GOOGLE_ADS_CONTACT_LABEL=tMbNCIOd-a8dEJmliolF
# WhatsApp / phone click conversions: add the labels once those conversions exist in Google Ads.
VITE_GOOGLE_ADS_WHATSAPP_LABEL=
VITE_GOOGLE_ADS_PHONE_LABEL=
